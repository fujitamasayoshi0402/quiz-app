              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"difficultyId\": \"{{difficultyId}}\",\n  \"question\": \"スモークテストの問題（{{runId}}）\",\n  \"explanation\": \"スモークテストの解説（更新後）\",\n  \"status\": \"published\",\n  \"choices\": [\n    {\n      \"body\": \"正解\",\n      \"isCorrect\": true\n    },\n    {\n      \"body\": \"不正解 1\",\n      \"isCorrect\": false\n    },\n    {\n      \"body\": \"不正解 2\",\n      \"isCorrect\": false\n    },\n    {\n      \"body\": \"不正解 3\",\n      \"isCorrect\": false\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 を返す\", () => pm.response.to.have.status(200));",
                  "const quiz = pm.response.json();",
                  "pm.test(\"更新が反映されている\", () => pm.expect(quiz.explanation).to.eql(\"スモークテストの解説（更新後）\"));",
