<mxfile host="drawio"><diagram name="container" id="container"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="クイズアプリ: コンテナ（C4 レベル 2、dev 環境）" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;利用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[人]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;一般ユーザーと管理者。ブラウザから使う&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="240" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ログインの画面（Managed Login）と、トークンの発行&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="240" height="110" as="geometry"/></mxCell><mxCell id="c6" value="クイズアプリ（AWS、東京リージョン）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1680" height="820" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Web アプリ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Next.js、Amplify Hosting]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;画面を描く。proxy が Cookie のトークンを取り出し、API に付けて中継する&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[HTTP API]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;入口。/api だけを通す。流量の上限&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;quiz-service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Kotlin + Spring Boot、ECS Fargate]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;出題・採点・管理・招待。トークンを検証し、テナントの所属で認可する&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="260" width="240" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[CDN]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;解説図を配る。署名を確かめ、CSP（sandbox）を付ける&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="240" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[解説図のバケット]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;draw.io の原本と SVG、画像、PDF。公開しない&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="240" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Serverless v2（min 0 ACU）]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;スキーマはサービスごと。テナントは行レベルセキュリティで分ける&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="240" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;SSM Parameter Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SecureString]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントの Webhook の URL、解説図の署名鍵&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="480" width="240" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[配送の記録]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;イベントの ID で重複を捨てる（TTL 7 日）&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="480" width="240" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[カスタムバス]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;クイズの変更のイベント。アーカイブ 7 日&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="700" width="240" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Kotlin、Lambda]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;通知するイベントを Slack の文面にして送る&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="700" width="240" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;SQS（DLQ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[キュー]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;送れなかった通知を 14 日残す&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="900" width="240" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;CloudWatch と SNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[ログ、アラーム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;5xx、タスクの停止、イベントの滞留、DLQ&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="900" width="240" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CI と dev へのデプロイ&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントの管理者が設定したチャンネル&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="700" width="240" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;運用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[人]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;開発し、デプロイし、アラームに対応する&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="900" width="240" height="100" as="geometry"/></mxCell><mxCell id="c22" value="画面を使う&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="ログインする" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="解説図を見る&lt;br&gt;[署名付き URL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" x="0.6" as="geometry"><Array as="points"><mxPoint x="35" y="95"/><mxPoint x="35" y="540"/></Array></mxGeometry></mxCell><mxCell id="c25" value="画像・PDF を直接上げる&lt;br&gt;[署名付き PUT]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" x="0.7" as="geometry"><Array as="points"><mxPoint x="370" y="128"/><mxPoint x="370" y="516"/></Array></mxGeometry></mxCell><mxCell id="c26" value="認可コードをトークンに替える&lt;br&gt;[OAuth 2.0 + PKCE]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" x="0.6" as="geometry"><Array as="points"><mxPoint x="264" y="205"/><mxPoint x="460" y="205"/></Array></mxGeometry></mxCell><mxCell id="c27" value="トークンを検証する（JWKS）&lt;br&gt;メールアドレスを取る（GetUser）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="190"/><mxPoint x="580" y="190"/></Array></mxGeometry></mxCell><mxCell id="c28" value="API を中継する&lt;br&gt;[HTTPS、Bearer]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="/api/{proxy+}&lt;br&gt;[VPC リンク]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="読む&lt;br&gt;[OAC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.65;entryX=0;entryY=0.65;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="図を置く・読み直す" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="776" y="430"/><mxPoint x="520" y="430"/></Array></mxGeometry></mxCell><mxCell id="c32" value="読み書き&lt;br&gt;[JDBC、IAM 認証]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Webhook の URL を書く&lt;br&gt;署名鍵を読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="332"/></Array></mxGeometry></mxCell><mxCell id="c34" value="クイズの変更&lt;br&gt;[Outbox から PutEvents]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1030" y="368"/><mxPoint x="1030" y="650"/><mxPoint x="860" y="650"/></Array></mxGeometry></mxCell><mxCell id="c35" value="通知するものだけ&lt;br&gt;[ルール、非同期]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="Webhook の URL を読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c16" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="重複を確かめる" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="c16" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="733"/></Array></mxGeometry></mxCell><mxCell id="c38" value="知らせる&lt;br&gt;[Incoming Webhook]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="送れなかったもの" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="アラーム&lt;br&gt;[メール]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="push・マージ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2060" y="950"/><mxPoint x="2060" y="315"/></Array></mxGeometry></mxCell><mxCell id="c42" value="イメージを載せる&lt;br&gt;[OIDC、ECR・ECS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="c19" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="矢印は依存の向き（呼ぶ側から呼ばれる側）。省略したもの: web の Amplify のビルドと notification-service の載せ替え（GitHub Actions が行う）、管理画面に埋め込む draw.io（コンテキスト図にある）、各部品のログ（CloudWatch Logs）。夜間（2:00〜8:00）は quiz-service のタスクを止める" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>