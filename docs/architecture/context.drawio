<mxfile host="drawio"><diagram name="context" id="context"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="クイズアプリ: システムコンテキスト（C4 レベル 1）" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;一般ユーザー&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[人]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントに所属し、カテゴリと難易度を選んでクイズを解く&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;管理者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[人]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントのクイズ・カテゴリ・難易度を作り、人を招待する&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;運用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[人]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;開発し、デプロイし、アラームに対応する&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="240" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;クイズアプリ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[ソフトウェアシステム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントごとに分けたクイズの出題・回答・管理。解説は Markdown と図&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="400" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ログインの画面（Managed Login）。パスキーとパスワード&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="240" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;draw.io&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;解説図を描く画面（embed.diagrams.net）。図のデータは送らない&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="580" width="240" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;テナントの管理者が設定したチャンネル&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="580" width="240" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[外部システム]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ソースと CI/CD（GitHub Actions）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="c12" value="クイズを解き、結果と履歴を見る&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="クイズを管理し、招待する&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="ログインする" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="115"/><mxPoint x="10" y="635"/></Array></mxGeometry></mxCell><mxCell id="c15" value="トークンを検証し、&lt;br&gt;確認済みのメールアドレスを取る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="解説図を描く画面を埋め込む&lt;br&gt;[iframe]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="クイズの追加・更新を知らせる&lt;br&gt;[Incoming Webhook]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="push・マージ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="テストし、dev に載せる&lt;br&gt;[OIDC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="アラームを知らせる&lt;br&gt;[メール]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="人は青、システムは濃い青、外部は灰色。矢印は依存の向き（呼ぶ側から呼ばれる側）。中の部品はコンテナ図（container.drawio）を参照" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1100" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>