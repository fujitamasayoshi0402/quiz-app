# docker compose と、ホストで動かす web / quiz-service が読む設定。.env にコピーして使う
#   cp .env.example .env

# ホスト側のポート。ほかのアプリと重なるときに変える
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
# LocalStack の番号を変えたら、ホストで動かす quiz-service にも FIGURES_S3_ENDPOINT と NOTIFICATIONS_SSM_ENDPOINT=http://localhost:<番号> を渡す
LOCALSTACK_PORT=4566

# ログイン（ADR-0016）。ローカルも dev の Cognito を使う。**必須。** 値は Terraform の出力から入れる
#   cd infra/terraform/envs/dev
#   terraform output -raw auth_issuer / auth_client_id / auth_client_secret
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Cookie の暗号鍵。ローカルでは何でもよい（openssl rand -base64 48 など）
AUTH_SESSION_SECRET=

# 画面の CSP で許す送り先（DEV-123）。ホストで動かす web が読む。docker compose の web には docker-compose.yml が渡す
CSP_IMG_SRC=http://localhost:4566
CSP_CONNECT_SRC=http://localhost:4566
