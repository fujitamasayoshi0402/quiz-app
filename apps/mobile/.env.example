# モバイルアプリの接続先（ADR-0032）。.env にコピーして埋める。どれも秘密ではなく、アプリの中に入る
# 値は infra/terraform/envs/dev で terraform output -raw <名前> を流して取る

# quiz_service_url（API Gateway。web の proxy は通さない）
EXPO_PUBLIC_API_ORIGIN=
# auth_issuer
EXPO_PUBLIC_AUTH_ISSUER=
# auth_mobile_client_id（web のクライアントではない）
EXPO_PUBLIC_AUTH_CLIENT_ID=
