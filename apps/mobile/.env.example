# モバイルアプリのつなぐ先（ADR-0032、DEV-208）。.env にコピーして埋める。どれも秘密ではなく、アプリの中に入る
# dev と prod の両方を埋めると、アプリの中で切り替えられる。片方だけなら、その環境に固定する
# 値は infra/terraform/envs/<環境> で terraform output -raw <名前> を流して取る（prod は main から）

# quiz_service_url（API Gateway。web の proxy は通さない）
EXPO_PUBLIC_DEV_API_ORIGIN=
# auth_issuer
EXPO_PUBLIC_DEV_AUTH_ISSUER=
# auth_mobile_client_id（web のクライアントではない）
EXPO_PUBLIC_DEV_AUTH_CLIENT_ID=
# web_url（結果の共有のリンクを作る。空なら、共有のボタンを出さない）
EXPO_PUBLIC_DEV_WEB_ORIGIN=

EXPO_PUBLIC_PROD_API_ORIGIN=
EXPO_PUBLIC_PROD_AUTH_ISSUER=
EXPO_PUBLIC_PROD_AUTH_CLIENT_ID=
EXPO_PUBLIC_PROD_WEB_ORIGIN=

# 自分の端末に入れるときだけ（DEV-210。開発ガイドラインの「自分の端末に入れる」）
# アプリの ID。Apple の中で重ならないもの（例: io.github.<GitHub の名前>.quiz）。英小文字・数字・ドットだけ（Android の決まり）
APP_ID=
# Apple のチームの ID（10 桁）。Xcode で Personal Team を選んだあとの、証明書の OU（security find-identity -v -p codesigning で出る名前の証明書）
APPLE_TEAM_ID=
